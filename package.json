{
  "name": "d0bar",
  "version": "0.1.0",
  "description": "A Dash0-branded observability toolbar for your own web app — that does not distort what it measures.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/d0bar.dev.iife.js",
    "!dist/d0bar.dev.iife.js.map",
    "!dist/d0bar.dev.panel.js",
    "!dist/d0bar.dev.panel.js.map",
    "readme.md",
    "architecture.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/d0bar.js"
    },
    "./iife": "./dist/d0bar.iife.js",
    "./panel": "./dist/d0bar.panel.js",
    "./package.json": "./package.json",
    "./sw": "./dist/d0bar-sw-module.mjs"
  },
  "scripts": {
    "tokens": "node scripts/vendor-tokens.mjs",
    "build": "pnpm tokens && pnpm -F @d0bar/signals build && pnpm typecheck && vite build && D0BAR_STAGE=2 vite build && D0BAR_STAGE=dev2 vite build && D0BAR_STAGE=sw vite build && D0BAR_STAGE=sw D0BAR_SW=module vite build && D0BAR_STAGE=worker vite build && D0BAR_STAGE=dev vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw && tsc --noEmit -p src/worker",
    "test": "vitest run && pnpm -F @d0bar/signals test",
    "test:watch": "vitest",
    "test:perf": "pnpm fixture:otel && pnpm fixture:trace && playwright test",
    "bench:serve": "node bench/fixtures/server.mjs",
    "size": "pnpm build && size-limit",
    "lint": "eslint . --cache --cache-location .cache/eslint --cache-strategy content && prettier --check . --cache --cache-location .cache/prettier",
    "format": "prettier --write .",
    "dev": "pnpm build && concurrently -n s1,panel,devpanel,sw,serve -c cyan,blue,gray,green,magenta \"vite build --watch\" \"D0BAR_STAGE=2 vite build --watch\" \"D0BAR_STAGE=dev2 vite build --watch\" \"D0BAR_STAGE=sw vite build --watch\" \"node --watch bench/fixtures/server.mjs\"",
    "prepublishOnly": "pnpm build && pnpm test && pnpm size",
    "fixture:otel": "node scripts/build-otel-fixture.mjs",
    "fixture:trace": "node scripts/build-trace-fixture.mjs",
    "test:perf:timing": "pnpm fixture:otel && pnpm fixture:trace && playwright test --project=timing --workers=1",
    "test:perf:behaviour": "pnpm fixture:otel && pnpm fixture:trace && playwright test --project=behaviour --workers=100%"
  },
  "devDependencies": {
    "@d0bar/signals": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@playwright/test": "^1.49.1",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "size-limit": "^11.1.6",
    "terser": "^5.37.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.18.0",
  "keywords": [
    "observability",
    "performance",
    "web-vitals",
    "toolbar",
    "opentelemetry",
    "devtools"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/big-kahuna-burger/d0bar.git"
  },
  "homepage": "https://github.com/big-kahuna-burger/d0bar#readme",
  "bugs": {
    "url": "https://github.com/big-kahuna-burger/d0bar/issues"
  }
}
