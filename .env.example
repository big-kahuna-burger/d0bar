# Dash0 forwarding for the `/try/` demo. Copy to `.env` and fill in the token.
#
# `bench/fixtures/server.mjs` reads this and forwards `/otlp/v1/*` to Dash0. The token stays
# in the server process and never reaches page script — see the note in that file for why.
#
# Only DASH0_TOKEN is required. Everything else has a default because everything else is
# guessable, and the token is not.

# Required. Create one in Dash0 under Settings -> Auth Tokens (ingest scope).
# `INGEST_TOKEN` works too — that is what Dash0's own UI calls it.
DASH0_TOKEN=

# prod | dev. Default dev, which is what this repo's org uses. Set prod for a production org.
# DASH0_ENV=dev

# aws | gcp. Default aws.
# DASH0_CLOUD=aws

# Default eu-west-1 on aws, europe-west4 on gcp.
# DASH0_REGION=eu-west-1

# Defaults to `default`. It was unset originally, because sending `dash0-dataset` is a claim
# the token must be authorized for and an ingest token often is not — it 401s with "not
# authorized to ingest into dataset". Omitting it let the token use its own dataset, which
# worked for ingest and broke the other end: the panel has to *name* a dataset to query, and a
# name nobody can state is a name nobody can type. So both ends now default to the same string,
# and an unauthorized token says so plainly instead of spans landing where the panel never looks.
#
# This is the *ingest* side only. d0bar's panel asks separately which dataset to **query**, in
# the connect surface, and it has to be the same one — a mismatch is answered 404 and the panel
# reports that it cannot tell whether the trace is missing or in another dataset. If you do not
# know your token's dataset name, Dash0's UI shows it under Settings -> Datasets.
# DASH0_DATASET=

# Full origin. Overrides ENV/CLOUD/REGION outright; only needed for a region not named above.
# DASH0_INGRESS=https://ingress.eu-west-1.aws.dash0.com
